{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "advanced-ai",
      "ignore": [
        "node_modules",
        ".git",
        "*.test.cjs",
        "*.log",
        ".env.example"
      ]
    }
  ]
}
